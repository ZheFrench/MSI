Bootstrap: docker
From: ubuntu:24.04

%labels
    Software bedtools
    Source https://packages.ubuntu.com/noble/bedtools

%help
    Conteneur Apptainer contenant bedtools (paquet Ubuntu 24.04).

    Utilisation :
        apptainer run bedtools.sif --help
        apptainer exec bedtools.sif bedtools intersect -a a.bed -b b.bed

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y && apt-get install -y --no-install-recommends bedtools
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec bedtools "$@"

%test
    bedtools --version