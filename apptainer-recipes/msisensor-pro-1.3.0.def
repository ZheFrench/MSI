# Étape 1 (build) : compilation depuis les sources.
Bootstrap: docker
From: ubuntu:24.04
Stage: build

%post
    export DEBIAN_FRONTEND=noninteractive

    # Dépendances nécessaires (cf. doc officielle)
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        ca-certificates \
        libbz2-dev \
        zlib1g-dev \
        libcurl4-openssl-dev \
        libncurses-dev \
        liblzma-dev \
        pkg-config \
        cmake

    # Récupération des sources et compilation
    cd /opt
    git clone --recursive https://github.com/xjtu-omics/msisensor-pro.git
    cd msisensor-pro
    ./INSTALL

# Étape 2 (image finale) : seulement le binaire, sa libhts et les bibliothèques
# d'exécution ; ni la chaîne de compilation, ni les sources (.git, demo).
Bootstrap: docker
From: ubuntu:24.04
Stage: final

%files from build
    /opt/msisensor-pro/binary/msisensor-pro /usr/local/bin/msisensor-pro
    /opt/msisensor-pro/vendor/htslib-1.11/libhts.so.3 /usr/local/lib/libhts.so.3

%labels
    Author jeanphilippe.villemin@chu-montpellier.fr
    Software msisensor-pro
    Source https://github.com/xjtu-omics/msisensor-pro

%help
    Conteneur Apptainer contenant MSIsensor-pro, compilé depuis les sources
    (https://github.com/xjtu-omics/msisensor-pro).

    Utilisation :
        apptainer run msisensor-pro.sif msisensor-pro --help
        apptainer exec msisensor-pro.sif msisensor-pro msi -d ref.list -t tumor.bam -o output

%post
    export DEBIAN_FRONTEND=noninteractive

    # Bibliothèques d'exécution de msisensor-pro et de libhts
    apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        libcurl4t64 \
        zlib1g \
        libbz2-1.0 \
        liblzma5
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    chmod +x /usr/local/bin/msisensor-pro
    ldconfig

%environment
    export PATH=/usr/local/bin:$PATH
    export LC_ALL=C

%runscript
    exec msisensor-pro "$@"

%test
    msisensor-pro --help || true
